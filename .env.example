NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://crypto:crypto@localhost:5432/authdb
JWT_ACCESS_SECRET=replace_with_a_very_long_random_string
COOKIE_SECRET=replace_with_another_secret
CORS_ORIGINS=http://localhost:5173,https://your-frontend.yourdomain.com

######################################################
# Storage Driver Selection
# Options: do | s3 | gcp
######################################################
STORAGE_DRIVER=do


######################################################
# DigitalOcean Spaces (default)
######################################################
DO_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_REGION=nyc3
DO_BUCKET=my-do-bucket
DO_ACCESS_KEY=your-do-access-key
DO_SECRET_KEY=your-do-secret-key


######################################################
# AWS S3
######################################################
AWS_REGION=us-east-1
AWS_BUCKET=my-s3-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key


######################################################
# Google Cloud Storage
######################################################
GCP_PROJECT_ID=my-gcp-project
GCP_BUCKET=my-gcp-bucket
# JSON key file contents or path
GCP_KEYFILE_PATH=/secrets/gcp-key.json
# OR inline credentials (base64 encoded JSON service account key)
GCP_KEYFILE_BASE64=
